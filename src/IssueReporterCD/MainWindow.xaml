<Window x:Class="IssueReporterCD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Issue Reporter"
        Icon="Assets/app.ico"
        Width="1060" Height="840" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Brush.Text}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Primary}" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding OpenSettingsCommand}" ToolTip="수집 경로와 저장 위치 설정"
                        Style="{StaticResource HeaderButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="설정" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="{StaticResource Brush.OnPrimary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Aurora Issue Reporter" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.OnPrimary}" />
                    <TextBlock Text="이슈 설명을 작성하면 장비 데이터와 함께 압축 파일로 만들어 줍니다."
                               FontSize="12" Foreground="{StaticResource Brush.OnPrimarySecondary}" />
                </StackPanel>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- Basic info -->
        <Grid Grid.Row="1" Margin="20,16,20,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}"><Run Text="장비 ID" /><Run Text=" *" Style="{StaticResource RequiredMark}" /></TextBlock>
                <TextBox Text="{Binding EquipmentId, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}"><Run Text="사이트" /><Run Text=" *" Style="{StaticResource RequiredMark}" /></TextBlock>
                <TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="라인" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Line, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Style="{StaticResource FieldLabel}"><Run Text="작성자" /><Run Text=" *" Style="{StaticResource RequiredMark}" /></TextBlock>
                <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Issue description (schema layers ③ symptom and ④ location; see docs/issue-schema.md) -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="14,14,4,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="이슈 설명" Style="{StaticResource SectionTitle}" />

                        <TextBlock Style="{StaticResource FieldLabel}"><Run Text="제목 (한 줄 요약)" /><Run Text=" *" Style="{StaticResource RequiredMark}" /></TextBlock>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}"><Run Text="발생 시각" /><Run Text=" *" Style="{StaticResource RequiredMark}" /></TextBlock>
                                <TextBox Text="{Binding OccurredAt, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="빈도" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Frequencies}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding Frequency}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="운전 모드" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding OperatingModes}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding OperatingMode}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="동작 단계" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding LifecyclePhases}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding LifecyclePhase}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="재현 여부" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Reproducibility}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding Reproducible}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="알람 코드 (여러 개면 쉼표로 구분)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AlarmCodes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom"><Run Text="실제 동작 (증상)" /><Run Text=" *" Style="{StaticResource RequiredMark}" /></TextBlock>
                            <TextBlock Grid.Column="1" Text="증상 유형" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="2" Width="200" ItemsSource="{Binding Templates}"
                                      SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Margin="0" />
                        </Grid>
                        <TextBox Style="{StaticResource MultiLineTextBox}" Height="110"
                                 Text="{Binding Symptom, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}"><Run Text="기대 동작 (원래 어떻게 되어야 하나)" /><Run Text=" *" Style="{StaticResource RequiredMark}" /></TextBlock>
                        <TextBox Style="{StaticResource MultiLineTextBox}" Height="50"
                                 Text="{Binding Expected, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}"><Run Text="재현 절차 (재현이 안 되면 발생 직전에 하던 작업)" /><Run Text=" *" Style="{StaticResource RequiredMark}" /></TextBlock>
                        <TextBox Style="{StaticResource MultiLineTextBox}" Height="66"
                                 Text="{Binding ReproSteps, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="조치 내용" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource MultiLineTextBox}" Height="50"
                                 Text="{Binding ActionsTaken, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="긴급도" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <RadioButton Content="상 (라인 정지)" GroupName="Severity" IsChecked="{Binding IsSeverityHigh}" />
                            <RadioButton Content="중" GroupName="Severity" IsChecked="{Binding IsSeverityMedium}" />
                            <RadioButton Content="하" GroupName="Severity" IsChecked="{Binding IsSeverityLow}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Data collection -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="데이터 수집" Style="{StaticResource SectionTitle}" />
                    <ProgressBar DockPanel.Dock="Top" Height="4" Margin="0,0,0,10" BorderThickness="0"
                                 IsIndeterminate="{Binding IsCollecting}"
                                 Visibility="{Binding IsCollecting, Converter={StaticResource BoolToVisibility}}"
                                 Foreground="{StaticResource Brush.Running}" Background="{StaticResource Brush.Track}" />
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Text="프로그램을 실행하는 순간 화면과 데이터를 자동으로 수집합니다. 버전, 설정 해시 같은 환경 정보도 자동으로 붙으니, 수집이 진행되는 동안 이슈 설명만 작성하세요." />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource StatusGlyph}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" ToolTip="{Binding Detail}"
                                               MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OutputPath}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="경로 복사" Style="{StaticResource SecondaryButton}" Command="{Binding CopyOutputPathCommand}" />
                    <Button Content="폴더 열기" Style="{StaticResource SecondaryButton}" Command="{Binding OpenOutputFolderCommand}" />
                    <Button Content="리포트 생성" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
