<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <!--
    설치 기본값입니다. 경로는 다음 순서로 정해집니다.
      1. 사용자가 설정 화면에서 지정한 값 (%ProgramData%\IssueReporterCD\settings.ini)
      2. Aurora가 제공하는 경로 파일 (AuroraDiscoveryFile)
      3. 아래 기본값
    경로에는 %ProgramData% 같은 환경 변수를 쓸 수 있습니다.
  -->
  <appSettings>
    <add key="AuroraDiscoveryFile" value="%ProgramData%\Aurora\IssueReporter.ini" />
    <!-- 아래 Aurora 경로는 임시값입니다. 실제 장비 경로로 바꿔야 합니다. -->
    <add key="AuroraLogDir" value="C:\Aurora\Logs" />
    <add key="AuroraSysErrorDir" value="C:\Aurora\SysError" />
    <add key="AuroraConfigDir" value="C:\Aurora\Config" />
    <!-- 최근 N일 동안 수정된 로그와 sys-error만 수집합니다. 0이면 전체를 수집합니다. -->
    <add key="LogMaxAgeDays" value="3" />
    <!-- 가장 최근 로그 시각이 현재와 이 시간 이상 차이 나면 경고합니다. -->
    <add key="LogGapWarningHours" value="24" />
    <!-- 비워두면 바탕화면\IssueReports 폴더에 저장합니다. -->
    <add key="OutputDir" value="" />
  </appSettings>
</configuration>
