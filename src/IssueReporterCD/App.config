<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <appSettings>
    <!-- 현장 장비의 실제 Aurora 경로로 바꿔야 합니다. 환경 변수(%ProgramData% 등)를 쓸 수 있습니다. -->
    <add key="AuroraLogDir" value="C:\Aurora\Logs" />
    <add key="AuroraConfigDir" value="C:\Aurora\Config" />
    <!-- 최근 N일 동안 수정된 로그만 수집합니다. 0이면 전체를 수집합니다. -->
    <add key="LogMaxAgeDays" value="3" />
    <!-- 비워두면 바탕화면\IssueReports 폴더에 저장합니다. -->
    <add key="OutputDir" value="" />
  </appSettings>
</configuration>
