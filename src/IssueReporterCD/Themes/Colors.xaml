<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Navy corporate theme (high contrast for field readability) -->
    <SolidColorBrush x:Key="Brush.Primary" Color="#0B2A4A" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#16406B" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="#071D34" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.OnPrimarySecondary" Color="#B9C8D8" />

    <SolidColorBrush x:Key="Brush.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#F4F7FA" />
    <SolidColorBrush x:Key="Brush.PanelHover" Color="#E8EEF4" />
    <SolidColorBrush x:Key="Brush.Border" Color="#C9D4DF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#8FA3B8" />
    <SolidColorBrush x:Key="Brush.InputFocus" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Track" Color="#DCE3EA" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="#9AA8B6" />

    <SolidColorBrush x:Key="Brush.Text" Color="#0B1A2A" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#4A5A6A" />

    <SolidColorBrush x:Key="Brush.Success" Color="#15803D" />
    <SolidColorBrush x:Key="Brush.Running" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B45309" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#B91C1C" />

</ResourceDictionary>
