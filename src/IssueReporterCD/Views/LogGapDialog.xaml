<Window x:Class="IssueReporterCD.Views.LogGapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="로그 시각 확인 - Aurora Issue Reporter"
        Icon="/IssueReporterCD;component/Assets/app.ico"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Brush.Text}">
    <StackPanel>
        <Grid Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                       Foreground="{StaticResource Brush.Warning}" Margin="0,0,16,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="설정이 잘못되었을 수 있습니다" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Cancel_Click" />
                <Button Content="그대로 생성" Style="{StaticResource SecondaryButton}" Click="Continue_Click" />
                <Button Content="설정 열기" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OpenSettings_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
