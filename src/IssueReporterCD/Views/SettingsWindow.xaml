<Window x:Class="IssueReporterCD.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정 - Aurora Issue Reporter"
        Icon="/IssueReporterCD;component/Assets/app.ico"
        Width="720" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Brush.Text}">
    <Window.Resources>
        <DataTemplate x:Key="PathField">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                    <Button Grid.Column="1" Content="찾아보기" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="12,5" Command="{Binding BrowseCommand}" />
                    <Button Grid.Column="2" Content="자동값" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="12,5" Command="{Binding ResetCommand}"
                            ToolTip="{Binding AutoValue}" />
                </Grid>
                <TextBlock Text="{Binding SourceText}" FontSize="11" Margin="0,3,0,0"
                           Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel>
        <Border Background="{StaticResource Brush.Primary}" Padding="20,12">
            <TextBlock Text="설정" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.OnPrimary}" />
        </Border>

        <StackPanel Margin="20,16,20,0">
            <TextBlock Text="수집 경로" Style="{StaticResource SectionTitle}" />
            <ContentControl Content="{Binding LogDir}" ContentTemplate="{StaticResource PathField}" Focusable="False" />
            <ContentControl Content="{Binding SysErrorDir}" ContentTemplate="{StaticResource PathField}" Focusable="False" />
            <ContentControl Content="{Binding ConfigDir}" ContentTemplate="{StaticResource PathField}" Focusable="False" />

            <TextBlock Text="리포트" Style="{StaticResource SectionTitle}" Margin="0,10,0,10" />
            <ContentControl Content="{Binding OutputDir}" ContentTemplate="{StaticResource PathField}" Focusable="False" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="로그 수집 기간 (일, 0이면 전체)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding LogMaxAgeDays, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="로그 시간 차이 경고 기준 (시간, 0이면 끔)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding LogGapWarningHours, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StorageInfo}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" />
        </StackPanel>

        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="취소" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                    <Button Content="저장" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
